import {
  "ZSeanYves/MoonJust/internal/cache",
  "ZSeanYves/MoonJust/internal/host",
  "ZSeanYves/MoonJust/internal/host/fs" @host_fs,
  "ZSeanYves/MoonJust/internal/path",
  "moonbitlang/async",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/async/fs" @async_fs,
  "moonbitlang/async/os_error",
  "moonbitlang/x/fs",
}

warnings = "-29"

supported_targets = "-all+native+wasm"

options(
  targets: {
    "canonical_native.mbt": [ "native", "llvm" ],
    "canonical_portable.mbt": [ "wasm", "wasm-gc", "js" ],
    "range_native.mbt": [ "native", "llvm" ],
    "range_portable.mbt": [ "wasm", "wasm-gc", "js" ],
    "source_reader_native.mbt": [ "native", "llvm" ],
    "source_reader_portable.mbt": [ "wasm", "wasm-gc", "js" ],
    "transaction_native.mbt": [ "native", "llvm" ],
    "transaction_portable.mbt": [ "wasm", "wasm-gc", "js" ],
    "async_script_native.mbt": [ "native", "llvm" ],
    "clock_native.mbt": [ "native", "llvm" ],
    "clock_portable.mbt": [ "wasm", "wasm-gc", "js" ],
    "platform_native.mbt": [ "native", "llvm" ],
    "platform_portable.mbt": [ "wasm", "wasm-gc", "js" ],
    "cache_native.mbt": [ "native", "llvm" ],
  },
)
