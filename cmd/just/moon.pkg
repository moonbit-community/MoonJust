import {
  "ZSeanYves/MoonJust/api" @moonjust,
  "ZSeanYves/MoonJust/src/application",
  "ZSeanYves/MoonJust/src/cli",
  "ZSeanYves/MoonJust/src/host",
  "ZSeanYves/MoonJust/src/host_native",
  "ZSeanYves/MoonJust/src/host_process",
  "ZSeanYves/MoonJust/src/host_wasm",
  "ZSeanYves/MoonJust/src/path",
  "ZSeanYves/MoonJust/src/lexer",
  "ZSeanYves/MoonJust/src/executor",
  "ZSeanYves/MoonJust/src/runtime",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/async/stdio",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

pkgtype(kind: "executable")

supported_targets = "-all+native+wasm"

// The native runtime adapter is imported for runtime_native.mbt only; the
// portable target intentionally does not reference that package.

warnings = "-29"

options(
  targets: {
    "runtime_native.mbt": [ "native", "llvm" ],
    "runtime_portable.mbt": [ "wasm", "wasm-gc", "js" ],
  },
)
