----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/process",
  "moonbitlang/core/env",
}
----

///|
async fn metadata(file : String) -> String {
  let args = if @async.platform is MacOS {
    ["-f", "%i:%Lp:%m", file]
  } else {
    ["-c", "%i:%a:%y", file]
  }
  @process.run("stat", args, stdout=Collect, accepted_exit_code=code => {
    code == 0
  }).stdout_text()
}

///|
async fn broken_pipe_is_ignored(wasm : String, cwd : String) -> Unit {
  let (reader, writer) = @process.read_from_process()
  reader.close()
  defer writer.close()
  let result = @process.run(
    "moonrun",
    [wasm, "--", "--list"],
    cwd~,
    stdin=Empty,
    stdout=Shared(writer),
    stderr=Collect,
  )
  assert_eq(result.exit_code, 0, msg=result.stderr_text())
  assert_eq(result.stderr_text(), "")
  if !(@async.platform is Windows) {
    // fd 1 refers to a read-only descriptor, so the write fails with EBADF.
    let bad_fd = @process.run(
      "sh",
      ["-c", "exec \"$@\" 1<justfile", "sh", "moonrun", wasm, "--", "--list"],
      cwd~,
      stdout=Collect,
      stderr=Collect,
    )
    assert_true(bad_fd.exit_code != 0)
    assert_false(bad_fd.stderr_text().is_empty())
  }
}

///|
async fn timestamp_and_shebang(
  program : String,
  prefix : Array[String],
) -> Unit {
  let root = @fs.realpath(@fs.tmpdir(prefix="moonjust-timestamp"))
  defer @fs.remove(root, recursive=true)
  async fn cli(args : Array[String]) -> @process.ProcessResult {
    @process.run(
      program,
      [..prefix, ..args],
      cwd=root,
      extra_env={ "TZ": "UTC+5" },
      stdout=Collect,
      stderr=Collect,
    )
  }
  let file = root + "/justfile"
  @fs.write_text(file, "run:\n    echo ran\n")
  let timestamped = cli(["--timestamp", "--timestamp-format", "%z", "run"])
  assert_eq(timestamped.exit_code, 0)
  assert_eq(timestamped.stdout_text(), "ran\n")
  assert_eq(timestamped.stderr_text(), "[-0500] echo ran\n")
  @fs.write_text(file, "[timestamp]\nrun:\n  @echo ran\n")
  let bare = cli(["--timestamp-format", "cli", "run"])
  assert_eq(bare.exit_code, 0, msg=bare.stderr_text())
  assert_eq(bare.stdout_text(), "ran\n")
  assert_eq(bare.stderr_text(), "[cli] echo ran\n")
  // Format expressions run once when a recipe starts, after its dependencies.
  @fs.write_text(
    file,
    (
      #|setup:
      #|  @echo recipe > stamp
      #|[timestamp(`cat stamp; printf x >> evaluations`)]
      #|run: setup
      #|  @echo one
      #|  @echo two
    ),
  )
  let lines = cli(["--timestamp-format", "cli", "run"])
  assert_eq(lines.exit_code, 0, msg=lines.stderr_text())
  assert_eq(lines.stderr_text(), "[recipe] echo one\n[recipe] echo two\n")
  assert_eq(lines.stdout_text(), "one\ntwo\n")
  assert_eq(@fs.read_text(root + "/evaluations"), "x")
  @fs.write_text(
    file,
    (
      #|[timestamp(`printf x >> evaluations; printf script`)]
      #|run:
      #|  #!/bin/sh
      #|  echo {{`cat evaluations`}}
    ),
  )
  let script = cli(["--quiet", "--timestamp", "--timestamp-format", "%Q", "run"])
  assert_eq(script.exit_code, 0, msg=script.stderr_text())
  assert_eq(script.stderr_text(), "[script] run\n")
  assert_eq(script.stdout_text(), "xx\n")
  @fs.write_text(file, "[timestamp(format='x')]\nrun:\n  @echo ok\n")
  let invalid = cli(["run"])
  assert_eq(invalid.exit_code, 1)
  assert_eq(invalid.stdout_text(), "")
  assert_eq(
    invalid.stderr_text(),
    (
      #|error: expected '&&', '!=', '!~', '||', ',', '==', '=~', '(', ')', '+', '++', or '/', but found '='
      #| ——▶ justfile:1:18
      #|  │
      #|1 │ [timestamp(format='x')]
      #|  │                  ^
      #|
    ),
  )
  @fs.write_text(
    file, "[timestamp('cache')]\n[cache]\n[script]\nrun:\n  echo ran\n",
  )
  for output in ["ran\n", ""] {
    let cached = cli(["--unstable", "run"])
    assert_eq(cached.exit_code, 0, msg=cached.stderr_text())
    assert_eq(cached.stdout_text(), output)
    assert_eq(cached.stderr_text(), "[cache] run\n")
  }
  // A Unix kernel must see #! at byte zero to execute the script directly.
  @fs.write_text(root + "/pwsh", "#!/bin/sh\nexec cat \"$@\"\n")
  @fs.chmod(root + "/pwsh", 0o755)
  @fs.write_text(file, "run:\n  #!{{justfile_directory()}}/pwsh\n  echo bar\n")
  let shebang = cli(["run"])
  assert_eq(shebang.exit_code, 0, msg=shebang.stderr_text())
  assert_eq(shebang.stdout_text(), "#!" + root + "/pwsh\n\necho bar\n")
  assert_eq(shebang.stderr_text(), "")
}

///|
async fn main {
  let wasm = @fs.realpath("_build/wasm/release/build/MoonJust.wasm")
  timestamp_and_shebang("moonrun", [wasm, "--"])
  if @env.args()[1:] is [oracle] {
    timestamp_and_shebang(@fs.realpath(oracle), [])
  }
  let root = @fs.realpath(@fs.tmpdir(prefix="moonjust-contract"))
  defer @fs.remove(root, recursive=true)
  let policy = root + "/policy.toml"
  @fs.write_text(
    policy, "[fs]\nread = ['.']\nwrite = ['.']\n[process]\nspawn = false\n",
  )
  async fn cli(args : Array[String]) -> @process.ProcessResult {
    @process.run(
      "moonrun",
      ["--policy", policy, wasm, "--", ..args],
      cwd=root,
      stdout=Collect,
      stderr=Collect,
    )
  }
  let file = root + "/justfile"
  @fs.write_text(file, "run:\n    echo ran\n")
  broken_pipe_is_ignored(wasm, root)
  @fs.write_text(
    file, "set unstable\nset lists\nvalue := style(['stdout','red'],'hello')\n",
  )
  for
    (mode, expected) in [
      ("auto", "hello"),
      ("never", "hello"),
      ("always", "\u{001b}[31mhello\u{001b}[0m"),
    ] {
    let result = @process.run(
      "moonrun",
      [wasm, "--color", mode, "--evaluate", "value"],
      cwd=root,
      stdout=Collect,
      stderr=Collect,
    )
    assert_eq(result.stdout_text(), expected)
  }
  for mode in ["auto", "never"] {
    let args = if @async.platform is MacOS {
      [
        "-q", "/dev/null", "moonrun", wasm, "--color", mode, "--evaluate", "value",
      ]
    } else {
      [
        "-q",
        "-e",
        "-c",
        "moonrun \"$MOONJUST_TEST_WASM\" --color " + mode + " --evaluate value",
        "/dev/null",
      ]
    }
    let result = @process.run(
      "script",
      args,
      extra_env={ "MOONJUST_TEST_WASM": wasm },
      cwd=root,
      stdin=Empty,
      stdout=Collect,
      stderr=Collect,
    )
    assert_true(result.stdout_text().contains("hello"))
    assert_eq(
      result.stdout_text().contains("\u{001b}[31mhello\u{001b}[0m"),
      mode == "auto",
    )
  }
  let executable = root + "/tool"
  @fs.write_text(executable, "")
  @fs.chmod(executable, 0o111)
  @fs.symlink(target="tool", root + "/alias")
  @fs.write_text(
    file,
    "set lists\nreal := canonicalize('alias')\nfound := require('" +
    executable +
    "')\nmaybe := which('" +
    executable +
    "')\n",
  )
  for binding in ["real", "found", "maybe"] {
    let result = cli(["--unstable", "--evaluate", binding])
    assert_eq(result.exit_code, 0, msg=result.stderr_text())
    assert_eq(result.stdout_text().trim_end().to_owned(), executable)
  }
  @fs.symlink(target="justfile", root + "/loop")
  @fs.write_text(file, "import 'loop'\n")
  let cycle = cli(["--list"])
  assert_eq(cycle.exit_code, 1)
  assert_true(cycle.stderr_text().contains("is circular"))
  for
    (source, mode, dirty) in [
      ("hello:\n echo hi\n", 0o751, true),
      ("hello:\n    echo hi\n", 0o644, false),
    ] {
    @fs.write_text(file, source)
    @fs.chmod(file, mode)
    let before = metadata(file)
    for check in [true, false] {
      let args = ["--unstable", "--fmt"]
      if check {
        args.push("--check")
      }
      let result = cli(args)
      assert_eq(
        result.exit_code,
        if dirty {
          1
        } else {
          0
        },
        msg=result.stderr_text(),
      )
      if dirty && !check {
        assert_true(result.stderr_text().contains("preserve its permissions"))
      }
      assert_eq(@fs.read_text(file), source)
      assert_eq(metadata(file), before)
    }
  }
  @fs.remove(file)
  let created = cli(["--justfile", "justfile", "--init"])
  assert_eq(created.exit_code, 0, msg=created.stderr_text())
  let original = @fs.read_text(file)
  let before = metadata(file)
  assert_eq(cli(["--justfile", "justfile", "--init"]).exit_code, 1)
  assert_eq(@fs.read_text(file), original)
  assert_eq(metadata(file), before)
}
