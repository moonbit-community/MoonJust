# Contract fixtures are byte-oriented inputs and must not be rewritten by
# platform-specific Git checkout settings.
tests/differential/cases/** text eol=lf
# Windows shell snapshots include the exact CRLF bytes written by the child.
tests/differential/cases/upstream-win159-*/**/expected.std* -text !eol
tests/differential/cases/upstream-win159-cmd-redirection/expected.tree -text !eol
tests/compatibility/upstream/** text eol=lf
# Raw line literals preserve source line endings, so this vendored document
# must remain byte-identical on every checkout.
internal/application/man_page.mbt text eol=lf
internal/application/just_changelog.mbt text eol=lf
